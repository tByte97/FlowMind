  <tag k="description" v="Нацисти вивезли їх потягом до м. Костопіль, де безжалісно розстріляли."/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="На цьому місці знаходився в'їзд у гетто - місце примусового утримання євреїв м. Рівне в час його окупації нацистською Німеччиною. Впродовж грудня 1941 - середини липня 1942 рр. у ньому поневірялося понад 5 тис. людей (з-поміж них - 1300 дітей)."/>
  <tag k="material" v="brick"/>
  <tag k="memorial" v="memorial"/>
  <tag k="name" v="Місце в'їзду у гетто де нацисти утримували євреїв"/>
  <tag k="name:uk" v="Місце в'їзду у гетто де нацисти утримували євреїв"/>
 </node>
