 <node id="7019020550" visible="true" version="2" changeset="133271287" timestamp="2023-03-03T21:44:58Z" user="avinet_ua" uid="1538111" lat="50.6182035" lon="26.2478909">
  <tag k="artist_name" v="Роман Велігурський"/>
  <tag k="artwork_type" v="sculpture"/>
  <tag k="description" v="Важить скульптура 800 кілограмів, а заввишки - 3 метри. У її волосся вплетені півсотні прикрас, які виготовили ковалі-учасники фестивалю &quot;Металеве серце&quot; з різних куточків України."/>
  <tag k="material" v="metal"/>
  <tag k="name" v="Кована скульптура &quot;Диво-Даринка&quot;"/>
