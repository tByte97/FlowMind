  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="В колишній гімназії в 1866-1871 роках вчився В. Г. Короленко, видатний російський письменник-демократ."/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Короленко Володимир Галактіонович"/>
  <tag k="name" v="Меморіальна дошка В. Г. Короленку"/>
  <tag k="name:uk" v="Меморіальна дошка В. Г. Короленку"/>
  <tag k="subject:wikipedia" v="uk:Короленко Володимир Галактіонович"/>
 </node>
 <node id="6669411631" visible="true" version="5" changeset="133271287" timestamp="2023-03-03T21:44:58Z" user="avinet_ua" uid="1538111" lat="50.6156007" lon="26.2480623">
  <tag k="description" v="Відомий український вчений, єпископ, митрополит Української автокефальної православної церкви, очільник Української греко-православної церкви Канади, політичний, громадський і церковний діяч, мовознавець, лексикограф, історик церкви, педагог."/>
  <tag k="historic" v="memorial"/>
  <tag k="inscription" v="У цьому будинку з кінця березня по травень 1919 року знаходилося Міністерство народної освіти УНР, яке очолював професор Іван Огієнко."/>
  <tag k="memorial" v="plaque"/>
  <tag k="memorial:subject" v="Митрополит Іларіон (світське ім'я Іва́н Іва́нович Огіє́нко)"/>
  <tag k="name" v="Меморіальна дошка митлополиту Іларіону (Іван Огієнко)"/>
  <tag k="name:uk" v="Меморіальна дошка митлополиту Іларіону (Іван Огієнко)"/>
  <tag k="start_date" v="24.05.2019"/>
  <tag k="subject:wikipedia" v="uk:Іларіон (Огієнко)"/>
 </node>
 <node id="6669549069" visible="true" version="2" changeset="78107757" timestamp="2019-12-08T12:18:36Z" user="K2_UNDERGROUND" uid="561874" lat="50.6231139" lon="26.2489119"/>
 <node id="6669549070" visible="true" version="21" changeset="182238360" timestamp="2026-05-05T08:42:10Z" user="b-jazz-bot" uid="9451067" lat="50.6229897" lon="26.2489046">
  <tag k="description" v="Видатний український письменник, народжений на Рівненщині (с. Дермань Здолбунівського району), журналіст і публіцист, редактор, автор книг «Волинь», «Марія», «Чого не гоїть огонь» та ін. Самчука називали українським Гомером ХХ століття."/>
  <tag k="name" v="Літературний музей Уласа Самчука"/>
