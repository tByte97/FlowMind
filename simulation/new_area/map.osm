 <node id="7019020552" visible="true" version="2" changeset="133271287" timestamp="2023-03-03T21:44:58Z" user="avinet_ua" uid="1538111" lat="50.6177334" lon="26.2478195">
  <tag k="artwork_type" v="sculpture"/>
  <tag k="description" v="Скульптура виконана у вигляді великого серця. Сорок одне невелике серце, виконане у різних ковальських техніках, прикрашає цю скульптуру."/>
