 </node>
 <node id="7019020551" visible="true" version="2" changeset="133271287" timestamp="2023-03-03T21:44:58Z" user="avinet_ua" uid="1538111" lat="50.6178956" lon="26.2478469">
  <tag k="artist_name" v="Артем Вольський"/>
  <tag k="artwork_type" v="sculpture"/>
  <tag k="description" v="Викувана у формі каруселі, нагорі якої тримаються за яблуко крилаті хлопчик та дівчинка."/>
  <tag k="material" v="metal"/>
