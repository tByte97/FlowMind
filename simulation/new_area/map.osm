 <node id="7019020554" visible="true" version="2" changeset="133271287" timestamp="2023-03-03T21:44:58Z" user="avinet_ua" uid="1538111" lat="50.6174757" lon="26.2477826">
  <tag k="artist_name" v="Артем Вольський"/>
  <tag k="artwork_type" v="sculpture"/>
  <tag k="description" v="В основі скульптури велетенські долоні, з яких проростає символічне дерево, на якому є 7 основних цінностей: любов, духовність, мир, милосердя, час, достаток та сім’я. Робота – заввишки 4 метри, а важить майже 3 тонни."/>
  <tag k="material" v="metal"/>
  <tag k="name" v="Кована скульптура &quot;Життєві цінності&quot;"/>
